{
  "manifest_version": 3,
  "default_locale": "ja",
  "name": "X Bookmark Shelf",
  "version": "0.1.3",
  "description": "__MSG_extensionDescription__",
  "permissions": ["tabs", "unlimitedStorage"],
  "host_permissions": ["https://x.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://x.com/*"], "js": ["content.js"] }],
  "action": { "default_title": "X Bookmark Shelf", "default_popup": "manager.html" }
}
